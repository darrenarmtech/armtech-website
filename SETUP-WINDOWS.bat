@echo off
echo =========================================
echo ARMTECH Website - GitHub Setup (Windows)
echo =========================================
echo.
echo STEP 1: Install GitHub Desktop (easiest method)
echo.
echo Please download and install GitHub Desktop:
echo https://desktop.github.com
echo.
pause
echo.
echo STEP 2: After installing GitHub Desktop:
echo.
echo 1. Open GitHub Desktop
echo 2. Sign in with your GitHub account (or create one)
echo 3. Click "File" → "Add local repository"
echo 4. Select THIS folder (armtech-site)
echo 5. Click "Publish repository"
echo 6. Name: armtech-website
echo 7. Make sure "Keep this code private" is UNCHECKED
echo 8. Click "Publish repository"
echo.
echo =========================================
echo ✅ Once published, your code is on GitHub!
echo =========================================
echo.
echo STEP 3: Enable GitHub Pages:
echo.
echo 1. Go to: https://github.com/YOUR-USERNAME/armtech-website
echo 2. Click "Settings" (top menu)
echo 3. Click "Pages" (left sidebar)
echo 4. Under "Source", select "main" branch
echo 5. Click "Save"
echo 6. Wait 2-3 minutes
echo 7. Refresh - you'll see your website URL!
echo.
echo Your site will be at:
echo https://YOUR-USERNAME.github.io/armtech-website/
echo.
echo =========================================
echo 🎉 DONE! Your website is LIVE!
echo =========================================
echo.
pause
